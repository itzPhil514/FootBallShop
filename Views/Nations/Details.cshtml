@model FootBallShop.Models.Nations
@{
    ViewData["Title"] = "Nation Details"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title">Nation Details</h2>
    <div class="fbs-title-bar"></div>
</div>

<div class="fbs-admin-card">
    <dl class="fbs-dl">
        <dt>Name</dt>
        <dd>@Model.Name</dd>
        <dt>League</dt>
        <dd>@Model.InterLeagues?.interLeaguesName</dd>
        <dt>Flag</dt>
        <dd><img src="@Url.Content($"~/img/nations/{Model.img}")" style="width:80px;height:80px;object-fit:contain;" /></dd>
    </dl>
    <div class="d-flex gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.NationId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>
