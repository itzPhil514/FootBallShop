@model FootBallShop.Models.Nations
@{
    ViewData["Title"] = "Create Nation"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title">Create Nation</h2>
    <div class="fbs-title-bar"></div>
</div>

<div class="fbs-admin-card">
    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="fbs-form-group">
            <label asp-for="Name" class="fbs-label">Name</label>
            <input asp-for="Name" class="form-control fbs-input" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="fbs-form-group">
            <label asp-for="interLeaguesId" class="fbs-label">International League</label>
            <select asp-for="interLeaguesId" class="form-select fbs-input" asp-items="ViewBag.interLeaguesId"></select>
        </div>
        <div class="fbs-form-group">
            <label asp-for="img" class="fbs-label">Flag / Logo</label>
            <input asp-for="img" class="form-control fbs-input" type="file" />
            <span asp-validation-for="img" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Create Nation</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
