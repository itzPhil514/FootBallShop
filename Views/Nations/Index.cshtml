@model IEnumerable<FootBallShop.Models.Nations>
@{
    ViewData["Title"] = "Nations"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title">Nations</h2>
    <div class="fbs-title-bar"></div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm flex-shrink-0">
            <i class="fas fa-plus me-1"></i> Add
        </a>
    }
</div>

<div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
    @foreach (var nation in Model)
    {
        <div class="col">
            <a href="@Url.Action("NationJersey", "Nations", new { id = nation.NationId })">
                <div class="fbs-card">
                    <div class="fbs-card-img-wrap">
                        <img src="@Url.Content($"~/img/nations/{(string.IsNullOrEmpty(nation.img) ? "default-placeholder.png" : nation.img)}")"
                             alt="@nation.Name" />
                    </div>
                    <div class="fbs-card-body">
                        <p class="fbs-card-name">@nation.Name</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
