@model FootBallShop.Models.Nations
@{
    ViewData["Title"] = Model.Name; Layout = "_Layout";
}

<div class="fbs-entity-header">
    <img src="@Url.Content($"~/img/nations/{Model.img}")" alt="@Model.Name" class="fbs-entity-logo" />
    <h1 class="fbs-entity-title">@Model.Name</h1>
    <a asp-controller="InterLeagues" asp-action="Index" class="fbs-back-link">
        <i class="fas fa-chevron-left"></i> International Leagues
    </a>
</div>

@if (Model.Jerseys != null && Model.Jerseys.Any())
{
    @foreach (var group in Model.Jerseys.GroupBy(j => j.Category))
    {
        <div class="fbs-category-section">
            <span class="fbs-category-pill">@group.Key</span>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                @foreach (var jersey in group)
                {
                    <div class="col">
                        <a asp-action="Details" asp-controller="Jerseys" asp-route-id="@jersey.JerseysId">
                            <div class="fbs-jersey-wrap h-100">
                                <div class="fbs-jersey-img-wrap">
                                    <span class="fbs-jersey-badge">@group.Key</span>
                                    <img class="fbs-jersey-card-img"
                                         src="@Url.Content($"~/img/jerseys/{jersey.img}")"
                                         alt="@jersey.Name" />
                                </div>
                                <div class="fbs-jersey-card-body">
                                    <p class="fbs-jersey-card-title">@jersey.Name</p>
                                    <p class="fbs-jersey-card-price">$@jersey.Price</p>
                                    <span class="fbs-jersey-card-action">View Jersey</span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
}
else
{
    <div class="fbs-empty">
        <i class="fas fa-tshirt d-block"></i>
        <p>No jerseys available for this nation yet.</p>
    </div>
}
