@model IEnumerable<FootBallShop.Controllers.AdminUserViewModel>
@{
    ViewData["Title"] = "Users";
    ViewData["AdminActive"] = "users";
    Layout = "_AdminLayout";
}

<div class="admin-page-head">
    <div>
        <p class="admin-kicker">Access control</p>
        <h1 class="admin-page-title">
            Users <span class="admin-pill red">@Model.Count()</span>
        </h1>
        <p class="admin-page-subtitle">Manage customer accounts and administrator permissions.</p>
    </div>
    <div class="admin-head-actions">
        <form asp-action="Users" method="get" class="admin-search">
            <i class="fas fa-search"></i>
            <input type="search" name="q" value="@ViewBag.Q"
                   placeholder="Search by email..." />
        </form>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="admin-alert">
        <i class="fas fa-circle-exclamation me-2"></i>@TempData["Error"]
    </div>
}

<section class="admin-card">
    <div class="admin-card-head">
        <div>
            <h2 class="admin-card-title">Account directory</h2>
            <span class="admin-card-meta">Use caution when changing roles or deleting accounts.</span>
        </div>
    </div>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Verification</th>
                    <th>Role</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var u in Model)
                    {
                        var isAdmin = u.Roles.Contains("Admin");
                        <tr>
                            <td>
                                <div class="admin-item">
                                    <div class="admin-avatar">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div class="admin-item-copy">
                                        <strong>@u.Email</strong>
                                        <span>@u.UserName</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (u.EmailConfirmed)
                                {
                                    <span class="admin-pill green">
                                        <i class="fas fa-check"></i> Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-pill amber">
                                        <i class="fas fa-clock"></i> Pending
                                    </span>
                                }
                            </td>
                            <td>
                                @if (isAdmin)
                                {
                                    <span class="admin-pill red">
                                        <i class="fas fa-shield-halved"></i> Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-pill">User</span>
                                }
                            </td>
                            <td>
                                <div class="admin-actions">
                                    <form asp-action="ToggleAdmin" method="post">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="admin-action"
                                                title="@(isAdmin ? "Remove admin" : "Make admin")"
                                                data-confirm="@(isAdmin ? "Remove admin access from this user?" : "Give this user administrator access?")">
                                            <i class="fas @(isAdmin ? "fa-user-minus" : "fa-user-shield")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="DeleteUser" method="post">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="admin-action danger"
                                                title="Delete user"
                                                data-confirm="Delete this user permanently? This cannot be undone.">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">
                            <div class="admin-empty">
                                <i class="fas fa-users"></i>
                                <strong>No users found</strong>
                                <span>Try a different search.</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
