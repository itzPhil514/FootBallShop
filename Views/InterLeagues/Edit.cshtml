@model FootBallShop.Models.InterLeagues
@{
    ViewData["Title"] = "Edit International League"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title">Edit International League</h2>
    <div class="fbs-title-bar"></div>
</div>

<div class="fbs-admin-card">
    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <input type="hidden" asp-for="interLeaguesId" />
        <div class="fbs-form-group">
            <label asp-for="interLeaguesName" class="fbs-label">Name</label>
            <input asp-for="interLeaguesName" class="form-control fbs-input" />
            <span asp-validation-for="interLeaguesName" class="text-danger small"></span>
        </div>
        <div class="fbs-form-group">
            <label asp-for="img" class="fbs-label">Logo</label>
            <input type="file" asp-for="img" class="form-control fbs-input" />
            <span asp-validation-for="img" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
