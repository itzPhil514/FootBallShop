@model FootBallShop.Models.InterLeagues
@{
    ViewData["Title"] = Model.interLeaguesName; Layout = "_Layout";
}

<div class="fbs-entity-header">
    <img src="@Url.Content($"~/img/interleagues/{Model.img}")" alt="@Model.interLeaguesName" class="fbs-entity-logo" />
    <h1 class="fbs-entity-title">@Model.interLeaguesName</h1>
    <a asp-controller="InterLeagues" asp-action="Index" class="fbs-back-link">
        <i class="fas fa-chevron-left"></i> All Leagues
    </a>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="mb-3">
        <a asp-action="Create" asp-controller="Nations" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i> Add Nation
        </a>
    </div>
}

<div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
    @foreach (var nation in Model.Nation)
    {
        <div class="col">
            <a href="@Url.Action("NationJersey", "Nations", new { id = nation.NationId })">
                <div class="fbs-card">
                    <div class="fbs-card-img-wrap">
                        <img src="@Url.Content($"~/img/nations/{(string.IsNullOrEmpty(nation.img) ? "default-placeholder.png" : nation.img)}")"
                             alt="@nation.Name" />
                    </div>
                    <div class="fbs-card-body">
                        <p class="fbs-card-name">@nation.Name</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
