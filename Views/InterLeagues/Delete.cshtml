@model FootBallShop.Models.InterLeagues
@{
    ViewData["Title"] = "Delete International League"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title">Delete International League</h2>
    <div class="fbs-title-bar"></div>
</div>

<div class="fbs-admin-card">
    <p class="fbs-delete-warning"><i class="fas fa-exclamation-triangle me-2"></i>Are you sure you want to delete <strong>@Model.interLeaguesName</strong>?</p>
    <dl class="fbs-dl mb-4">
        <dt>Name</dt>
        <dd>@Model.interLeaguesName</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="interLeaguesId" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
