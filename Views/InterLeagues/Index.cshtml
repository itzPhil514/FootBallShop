@model IEnumerable<FootBallShop.Models.InterLeagues>
@{
    ViewData["Title"] = "International Leagues"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title">International</h2>
    <div class="fbs-title-bar"></div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm flex-shrink-0">
            <i class="fas fa-plus me-1"></i> Add
        </a>
    }
</div>

<div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
    @foreach (var il in Model)
    {
        <div class="col">
            <a href="@Url.Action("NationsByInterLeague", "InterLeagues", new { id = il.interLeaguesId })">
                <div class="fbs-card">
                    <div class="fbs-card-img-wrap">
                        <img src="@Url.Content($"~/img/interleagues/{(string.IsNullOrEmpty(il.img) ? "default-placeholder.png" : il.img)}")"
                             alt="@il.interLeaguesName" />
                    </div>
                    <div class="fbs-card-body">
                        <p class="fbs-card-name">@il.interLeaguesName</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
