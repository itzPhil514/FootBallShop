@model IEnumerable<FootBallShop.Models.Leagues>
@{
    ViewData["Title"] = "Leagues"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title">Leagues</h2>
    <div class="fbs-title-bar"></div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm flex-shrink-0">
            <i class="fas fa-plus me-1"></i> Add
        </a>
    }
</div>

<div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
    @foreach (var league in Model)
    {
        <div class="col">
            <a href="@Url.Action("ClubsByLeague", "Leagues", new { id = league.LeagueId })">
                <div class="fbs-card">
                    <div class="fbs-card-img-wrap">
                        <img src="@Url.Content($"~/img/leagues/{(string.IsNullOrEmpty(league.imgLeaguePath) ? "default-placeholder.png" : league.imgLeaguePath)}")"
                             alt="@league.LeagueName" />
                    </div>
                    <div class="fbs-card-body">
                        <p class="fbs-card-name">@league.LeagueName</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
