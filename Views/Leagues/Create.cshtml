@model FootBallShop.Models.Leagues
@{
    ViewData["Title"] = "Create League"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title">Create League</h2>
    <div class="fbs-title-bar"></div>
</div>

<div class="fbs-admin-card">
    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="fbs-form-group">
            <label asp-for="LeagueName" class="fbs-label">Name</label>
            <input asp-for="LeagueName" class="form-control fbs-input" />
            <span asp-validation-for="LeagueName" class="text-danger small"></span>
        </div>
        <div class="fbs-form-group">
            <label asp-for="imgLeaguePath" class="fbs-label">Logo</label>
            <input type="file" asp-for="imgLeaguePath" class="form-control fbs-input" />
            <span asp-validation-for="imgLeaguePath" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Create League</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
