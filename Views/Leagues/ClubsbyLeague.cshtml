@model FootBallShop.Models.Leagues
@{
    ViewData["Title"] = Model.LeagueName; Layout = "_Layout";
}

<div class="fbs-entity-header">
    <img src="@Url.Content($"~/img/leagues/{Model.imgLeaguePath}")" alt="@Model.LeagueName" class="fbs-entity-logo" />
    <h1 class="fbs-entity-title">@Model.LeagueName</h1>
    <a asp-controller="Leagues" asp-action="Index" class="fbs-back-link">
        <i class="fas fa-chevron-left"></i> All Leagues
    </a>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="mb-3">
        <a asp-action="Create" asp-controller="Clubs" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i> Add Club
        </a>
    </div>
}

<div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
    @foreach (var club in Model.Clubs)
    {
        <div class="col">
            <a href="@Url.Action("Jersey", "Clubs", new { id = club.ClubId })">
                <div class="fbs-card">
                    <div class="fbs-card-img-wrap">
                        <img src="@Url.Content($"~/img/clubs/{(string.IsNullOrEmpty(club.img) ? "default-placeholder.png" : club.img)}")"
                             alt="@club.Name" />
                    </div>
                    <div class="fbs-card-body">
                        <p class="fbs-card-name">@club.Name</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
