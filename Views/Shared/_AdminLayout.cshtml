<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FootBallShop Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-app" id="adminApp">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-top">
                <a asp-controller="Admin" asp-action="Index" class="admin-brand">
                    <span class="admin-brand-mark"><i class="fas fa-futbol"></i></span>
                    <span class="admin-brand-copy"><strong>FOOTBALL</strong><small>SHOP ADMIN</small></span>
                </a>
                <button class="admin-mobile-close" type="button" id="adminSidebarClose" aria-label="Close menu">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="admin-profile">
                <div class="admin-avatar"><i class="fas fa-user-shield"></i></div>
                <div><strong>Administrator</strong><span>Store management</span></div>
                <span class="admin-status-dot"></span>
            </div>

            <nav class="admin-nav" aria-label="Admin navigation">
                <div class="admin-nav-label">Workspace</div>
                <a asp-controller="Admin" asp-action="Index" class="admin-nav-item @(ViewData["AdminActive"]?.ToString() == "dashboard" ? "active" : "")"><i class="fas fa-chart-pie"></i><span>Dashboard</span></a>
                <a asp-controller="Admin" asp-action="Jerseys" class="admin-nav-item @(ViewData["AdminActive"]?.ToString() == "jerseys" ? "active" : "")"><i class="fas fa-shirt"></i><span>Jerseys</span></a>
                <a asp-controller="Admin" asp-action="Leagues" class="admin-nav-item @(ViewData["AdminActive"]?.ToString() == "leagues" ? "active" : "")"><i class="fas fa-trophy"></i><span>Leagues</span></a>
                <a asp-controller="Admin" asp-action="Clubs" class="admin-nav-item @(ViewData["AdminActive"]?.ToString() == "clubs" ? "active" : "")"><i class="fas fa-shield-halved"></i><span>Clubs</span></a>
                <a asp-controller="Admin" asp-action="InterLeagues" class="admin-nav-item @(ViewData["AdminActive"]?.ToString() == "interleagues" ? "active" : "")"><i class="fas fa-globe"></i><span>International</span></a>
                <a asp-controller="Admin" asp-action="Nations" class="admin-nav-item @(ViewData["AdminActive"]?.ToString() == "nations" ? "active" : "")"><i class="fas fa-flag"></i><span>Nations</span></a>
                <div class="admin-nav-label admin-nav-label-spaced">Access</div>
                <a asp-controller="Admin" asp-action="Users" class="admin-nav-item @(ViewData["AdminActive"]?.ToString() == "users" ? "active" : "")"><i class="fas fa-users"></i><span>Users</span></a>
            </nav>

            <div class="admin-sidebar-bottom">
                <a asp-controller="Home" asp-action="Index" class="admin-nav-item"><i class="fas fa-arrow-left"></i><span>Back to store</span></a>
            </div>
        </aside>

        <div class="admin-sidebar-overlay" id="adminSidebarOverlay"></div>

        <main class="admin-main">
            <header class="admin-mobile-header">
                <button type="button" class="admin-icon-btn" id="adminSidebarOpen" aria-label="Open menu"><i class="fas fa-bars"></i></button>
                <a asp-controller="Admin" asp-action="Index" class="admin-mobile-brand"><i class="fas fa-futbol"></i> FOOTBALLSHOP</a>
                <a asp-controller="Home" asp-action="Index" class="admin-icon-btn" aria-label="Store"><i class="fas fa-store"></i></a>
            </header>
            <div class="admin-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
