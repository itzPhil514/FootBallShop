<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FootBallShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FootBallShop.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid gap-3">
                <button class="btn btn-link p-0" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar"
                        style="color:var(--text-primary);">
                    <i class="fas fa-bars fa-lg"></i>
                </button>

                <a class="navbar-brand mx-auto" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo1.png" alt="FootBallShop" style="height:60px;width:60px;" />
                </a>

                <div id="search-container" class="flex-grow-1" style="max-width:420px;">
                    <div class="input-group">
                        <input class="form-control" type="search" id="search-query"
                               placeholder="Search jerseys, clubs, nations…"
                               aria-label="Search" autocomplete="off" />
                        <button class="btn btn-outline-success" type="button" id="search-btn">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                    <div id="search-results">
                        <div class="fbs-search-tabs">
                            <button class="fbs-search-tab active" data-type="all">All</button>
                            <button class="fbs-search-tab" data-type="jerseys">Jerseys</button>
                            <button class="fbs-search-tab" data-type="clubs">Clubs</button>
                            <button class="fbs-search-tab" data-type="nations">Nations</button>
                        </div>
                        <div id="search-results-list"></div>
                    </div>
                </div>

                <ul class="navbar-nav flex-row gap-3 align-items-center">
                    <li class="nav-item">
                        <button id="theme-toggle" aria-label="Toggle dark mode">
                            <i class="fas fa-moon" id="theme-icon"></i>
                            <span id="theme-label">Dark</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link heart-icon-container" asp-controller="Wishlist" asp-action="Index"
                           style="color:var(--text-primary);" title="Wishlist">
                            <i class="fas fa-heart fa-lg"></i>
                            <span id="wishlist-quantity" class="wishlist-quantity-badge" style="display:none;">0</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link cart-icon-container" asp-controller="Cart" asp-action="Index"
                           style="color:var(--text-primary);" title="Cart">
                            <i class="fas fa-shopping-cart fa-lg"></i>
                            <span id="cart-quantity" class="cart-quantity-badge" style="display:none;">0</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <partial name="_LoginPartial" />
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar">
        <div class="offcanvas-header">
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-futbol text-danger"></i>
                <h5 class="offcanvas-title mb-0">FootBallShop</h5>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home me-2"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Leagues" asp-action="Index">
                        <i class="fas fa-trophy me-2"></i> Leagues
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="InterLeagues" asp-action="Index">
                        <i class="fas fa-globe me-2"></i> International
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Index">
                            <i class="fas fa-shield-alt me-2"></i> Admin Panel
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="fbs-toast-container">
            <div class="fbs-toast fbs-toast-success" id="fbs-toast">
                <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="fbs-toast-container">
            <div class="fbs-toast fbs-toast-error" id="fbs-toast">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            </div>
        </div>
    }

    <div class="container-fluid px-3 px-md-4">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
