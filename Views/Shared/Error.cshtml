@model ErrorViewModel
@{
    ViewData["Title"] = "Error"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title" style="color:var(--red);">Something went wrong</h2>
    <div class="fbs-title-bar"></div>
</div>

<div class="fbs-admin-card">
    <p style="color:var(--text-secondary);">An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
        <i class="fas fa-home me-2"></i> Back to Home
    </a>
</div>
