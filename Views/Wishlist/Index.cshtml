@model List<FootBallShop.Models.Wishlist>
@{
    ViewData["Title"] = "Your Wishlist";
}

<div class="fbs-section-header">
    <h2 class="page-title">Wishlist</h2>
    <div class="fbs-title-bar"></div>
</div>

@if (Model.Any())
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="fbs-wish-wrap h-100">
                    <a asp-controller="Jerseys" asp-action="Details" asp-route-id="@item.jerseys.JerseysId">
                        <div class="fbs-jersey-img-wrap">
                            <img src="@Url.Content($"~/img/jerseys/{item.jerseys.img}")"
                                 class="fbs-jersey-card-img" alt="@item.jerseys.Name" />
                        </div>
                        <div class="fbs-jersey-card-body">
                            <p class="fbs-jersey-card-title">@item.jerseys.Name</p>
                            <p class="fbs-jersey-card-price">$@item.jerseys.Price</p>
                        </div>
                    </a>
                    <div style="padding:0 1rem 1rem;">
                        <form asp-action="RemoveFromWishlist" method="post">
                            <input type="hidden" name="TshirtId" value="@item.jerseys.JerseysId" />
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                <i class="fas fa-trash me-1"></i> Remove
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="fbs-empty">
        <i class="fas fa-heart d-block"></i>
        <p>Your wishlist is empty.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Discover Jerseys</a>
    </div>
}
