@model FootBallShop.Models.Jerseys
@{
    ViewData["Title"] = "Edit Jersey"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title">Edit Jersey</h2>
    <div class="fbs-title-bar"></div>
</div>

<div class="fbs-admin-card">
    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <input type="hidden" asp-for="JerseysId" />
        <div class="fbs-form-group">
            <label asp-for="Name" class="fbs-label">Name</label>
            <input asp-for="Name" class="form-control fbs-input" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="fbs-form-group">
            <label asp-for="Size" class="fbs-label">Size</label>
            <input asp-for="Size" class="form-control fbs-input" />
        </div>
        <div class="fbs-form-group">
            <label asp-for="Price" class="fbs-label">Price ($)</label>
            <input asp-for="Price" class="form-control fbs-input" />
        </div>
        <div class="fbs-form-group">
            <label asp-for="LeagueId" class="fbs-label">League</label>
            <select asp-for="LeagueId" class="form-select fbs-input" asp-items="ViewBag.LeagueId"></select>
        </div>
        <div class="fbs-form-group">
            <label asp-for="ClubId" class="fbs-label">Club</label>
            <select asp-for="ClubId" class="form-select fbs-input" asp-items="ViewBag.ClubId"></select>
        </div>
        <div class="fbs-form-group">
            <label asp-for="img" class="fbs-label">Jersey Image</label>
            <input asp-for="img" class="form-control fbs-input" type="file" />
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
