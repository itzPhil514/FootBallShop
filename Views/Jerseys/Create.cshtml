@model FootBallShop.Models.Jerseys
@{
    ViewData["Title"] = "Create Jersey"; Layout = "_Layout";
}

<div class="fbs-section-header">
    <h2 class="page-title">Create Jersey</h2>
    <div class="fbs-title-bar"></div>
</div>

<div class="fbs-admin-card">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="fbs-form-group">
            <span class="fbs-label">Type</span>
            <div class="d-flex gap-3 mt-1">
                <div class="form-check">
                    <input type="radio" asp-for="IsInter" value="false" id="IsInterFalse" class="form-check-input" checked />
                    <label for="IsInterFalse" class="form-check-label">Club</label>
                </div>
                <div class="form-check">
                    <input type="radio" asp-for="IsInter" value="true" id="IsInterTrue" class="form-check-input" />
                    <label for="IsInterTrue" class="form-check-label">International</label>
                </div>
            </div>
        </div>

        <div class="fbs-form-group">
            <label asp-for="Name" class="fbs-label">Name</label>
            <input asp-for="Name" class="form-control fbs-input" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="fbs-form-group">
            <label asp-for="Price" class="fbs-label">Price ($)</label>
            <input asp-for="Price" class="form-control fbs-input" />
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>


        <div class="fbs-form-group">
            <label asp-for="Category" class="fbs-label">Category</label>
            <select asp-for="Category" class="form-select fbs-input">
                <option value="">Select Category</option>
                <option>Jersey</option>
                <option>Training Kit</option>
                <option>Goalkeeper Kit</option>
                <option>Warm-up Kit</option>
            </select>
        </div>

        <div id="regular-jersey-fields">
            <div class="fbs-form-group">
                <label asp-for="LeagueId" class="fbs-label">League</label>
                <select asp-for="LeagueId" class="form-select fbs-input" id="LeagueDropdown">
                    <option value="">Select League</option>
                </select>
            </div>
            <div class="fbs-form-group">
                <label asp-for="ClubId" class="fbs-label">Club</label>
                <select asp-for="ClubId" class="form-select fbs-input" id="ClubDropdown">
                    <option value="">Select Club</option>
                </select>
            </div>
        </div>

        <div id="international-jersey-fields" style="display:none;">
            <div class="fbs-form-group">
                <label asp-for="interLeaguesId" class="fbs-label">International League</label>
                <select asp-for="interLeaguesId" class="form-select fbs-input" id="InterLeagueDropdown">
                    <option value="">Select League</option>
                </select>
            </div>
            <div class="fbs-form-group">
                <label asp-for="NationId" class="fbs-label">Nation</label>
                <select asp-for="NationId" class="form-select fbs-input" id="NationDropdown">
                    <option value="">Select Nation</option>
                </select>
            </div>
        </div>

        <div class="fbs-form-group">
            <label asp-for="img" class="fbs-label">Jersey Image</label>
            <input asp-for="img" type="file" class="form-control fbs-input" />
            <span asp-validation-for="img" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Create Jersey</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
